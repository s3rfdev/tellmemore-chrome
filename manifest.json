{
  "manifest_version": 3,
  "name": "TellMeMore — AI Copilot for Messengers",
  "version": "1.0.0",
  "description": "Universal AI Copilot and negotiation assistant for Facebook Messenger and web messengers",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.messenger.com/*",
    "*://*.telegram.org/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*",
    "https://api.x.ai/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/ui/popup/popup.html",
    "default_title": "TellMeMore Settings"
  },
  "side_panel": {
    "default_path": "src/ui/sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.messenger.com/*",
        "*://web.telegram.org/*",
        "*://*.telegram.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
